# 经营归因分析系统 · 生产环境模板
# 用法：在云服务器上 `cp .env.production.example .env`，然后把每个 <...> 占位符换成真实值。
# 所有生成命令在本机或服务器任意目录执行均可；.env 与 secrets/ 均已被 .gitignore 排除。

# ---- 数据库（必填，缺失时 docker compose 会直接报错拒绝启动）----
DB_USER=bia
DB_NAME=bia
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(24))"
DB_PASSWORD=<生成的强密码>
MYSQL_ROOT_PASSWORD=<生成的强密码>

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- OIDC 认证中心 ----
OIDC_CLIENT_ID=bia-web
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
OIDC_CLIENT_SECRET=<生成的强随机串>
# 浏览器实际访问地址（有域名填域名，只有 IP 就填 http://IP:8080）
OIDC_REDIRECT_URI=http://<服务器IP或域名>:8080/auth/callback

# ---- JWT 签名私钥（必配）----
# 多行 PEM 不走 .env，执行：
#   mkdir -p secrets && openssl genrsa -out secrets/oidc_rsa_private.pem 2048
# 详见 secrets/README.md

# ---- 数据源密码 AES 加密密钥（必填）----
# 生成：python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=<生成的密钥>

# ---- 功能开关 ----
FLAG_SCENARIO_DATA=true
# 生产保持 false：关闭 LLM 任意命令执行
FLAG_COMMAND_EXEC=false
FLAG_ATTACHMENT=true
FLAG_EXTERNAL_DS=false
FLAG_RESULT_GENERATE=false
FLAG_WS_HEARTBEAT=true

# ---- 资源限制（4C4G 服务器按一半资源规划）----
TASK_CONCURRENCY_LIMIT=3
WS_MAX_CONNECTIONS=10

# ---- LLM ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=<DeepSeek API Key，也可部署后在管理后台配置>

# ---- 环境 ----
APP_ENV=prod
# Secure Cookie：留空=跟随 APP_ENV（prod 时 Secure）。
# 若当前以 http://IP:8080 直连（无 HTTPS 网关），必须显式设 false，否则登录必然失败；
# 后续上了 HTTPS 网关后删掉此行或改回 true 即可。
COOKIE_SECURE=false
# 与浏览器实际访问地址一致，多个用逗号分隔
CORS_ORIGINS=["http://<服务器IP或域名>:8080"]

# ---- 服务器侧还需完成的防火墙配置（云安全组同理）----
# sudo ufw default deny incoming
# sudo ufw default allow outgoing
# sudo ufw allow 22/tcp     # SSH
# sudo ufw allow 8080/tcp   # 前端入口
# sudo ufw enable
# 3306 / 6379 / 8001 已在 docker-compose 中仅绑定 127.0.0.1，无需也不应放行。

# 经营归因分析系统 · 环境变量示例（复制为 .env 后填写）
# 说明：.env 已被 .gitignore 排除，切勿提交真实密钥。
# 上线服务器请参考 .env.production.example（生产模板）。

# ---- 数据库 ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=bia
DB_PASSWORD=bia_password
DB_NAME=bia
MYSQL_ROOT_PASSWORD=root_password

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- OIDC 认证中心 ----
OIDC_ISSUER=http://auth:8000
OIDC_CLIENT_ID=bia-web
OIDC_CLIENT_SECRET=change-me-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# ---- JWT 签名私钥（生产必配，见 secrets/README.md）----
# 多行 PEM 无法写入 .env：生成后放到 ./secrets/oidc_rsa_private.pem，
# docker-compose 会挂载进容器并由 entrypoint 自动注入。
# 生成：openssl genrsa -out secrets/oidc_rsa_private.pem 2048
# 不配置时应用会生成临时密钥（重启后所有登录态失效，仅限开发）。

# ---- 加密（数据源密码 AES；生产必填 32 字节 url-safe base64）----
# 生成：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=

# ---- 功能开关 ----
FLAG_SCENARIO_DATA=true
# 命令执行工具：生产环境保持 false，避免 LLM 触发任意命令执行
FLAG_COMMAND_EXEC=false
FLAG_ATTACHMENT=true
FLAG_EXTERNAL_DS=false
FLAG_RESULT_GENERATE=false
FLAG_WS_HEARTBEAT=true

# ---- 资源限制（2C2G）----
TASK_CONCURRENCY_LIMIT=3
WS_MAX_CONNECTIONS=10

# ---- LLM（运行时也可在管理后台配置）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---- 环境 ----
APP_ENV=prod
# 生产环境只放行实际访问地址（域名或 http://服务器IP:8080）
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
